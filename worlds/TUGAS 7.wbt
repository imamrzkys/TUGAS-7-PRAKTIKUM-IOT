# --- ROBOT LINE FOLLOWER LENGKAP HASIL TINKERCAD ---
Robot {
  translation -0.8 -0.8 0.0325
  rotation 0 0 1 0
  children [
    # Model 3D Sasis Lengkap dari Tinkercad (Skala mm -> meter = 0.001)
    Transform {
      scale 0.001 0.001 0.001
      children [
        CadShape {
          url [
            "../meshes/chassis_complete.obj"
          ]
          castShadows FALSE
        }
      ]
    }
    # Roda Kiri + Motor
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor 0 0.08 0
      }
      device [
        RotationalMotor {
          name "left_motor"
          maxVelocity 20
          maxTorque 10
        }
      ]
      endPoint Solid {
        translation 0 0.08 0
        children [
          Transform {
            scale 0.001 0.001 0.001
            children [
              CadShape {
                url [
                  "../meshes/wheel_complete.obj"
                ]
                castShadows FALSE
              }
            ]
          }
        ]
        name "left_wheel"
        boundingObject Pose {
          rotation 1 0 0 1.5708
          children [
            Cylinder {
              height 0.025
              radius 0.0325
            }
          ]
        }
        physics Physics {
          density -1
          mass 0.05
        }
      }
    }
    # Roda Kanan + Motor
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor 0 -0.08 0
      }
      device [
        RotationalMotor {
          name "right_motor"
          maxVelocity 20
          maxTorque 10
        }
      ]
      endPoint Solid {
        translation 0 -0.08 0
        children [
          Transform {
            scale 0.001 0.001 0.001
            children [
              CadShape {
                url [
                  "../meshes/wheel_right_complete.obj"
                ]
                castShadows FALSE
              }
            ]
          }
        ]
        name "right_wheel"
        boundingObject Pose {
          rotation 1 0 0 1.5708
          children [
            Cylinder {
              height 0.025
              radius 0.0325
            }
          ]
        }
        physics Physics {
          density -1
          mass 0.05
        }
      }
    }
    # Roda Penyeimbang Depan (Caster Wheel Licin)
    Solid {
      translation 0.125 0 -0.0225
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.75 0.1 0.1
            roughness 0.4
            metalness 0.2
          }
          geometry DEF CASTER_SPHERE Sphere {
            radius 0.01
          }
        }
      ]
      name "front_caster"
      contactMaterial "caster"
      boundingObject USE CASTER_SPHERE
      physics Physics {
        density -1
        mass 0.01
      }
    }
    # Sensor Inframerah Kiri (Menghadap Tegak Lurus ke Bawah)
    DistanceSensor {
      translation 0.15 0.025 -0.015
      rotation 0 1 0 1.5708
      name "ir_left"
      lookupTable [
        0 1000 0
        0.025 1000 0
        0.06 0 0
      ]
      type "infra-red"
      numberOfRays 1
      aperture 0.1
    }
    # Sensor Inframerah Kanan (Menghadap Tegak Lurus ke Bawah)
    DistanceSensor {
      translation 0.15 -0.025 -0.015
      rotation 0 1 0 1.5708
      name "ir_right"
      lookupTable [
        0 1000 0
        0.025 1000 0
        0.06 0 0
      ]
      type "infra-red"
      numberOfRays 1
      aperture 0.1
    }
  ]
  name "line_follower_imam"
  boundingObject Pose {
    translation 0.03 0 0.005
    children [
      Box {
        size 0.15 0.11 0.03
      }
    ]
  }
  physics Physics {
    density -1
    mass 0.45
    centerOfMass [
      0.03 0 -0.005
    ]
  }
  controller "line_follower_controller"
}
