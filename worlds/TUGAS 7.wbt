WorldInfo {
  basicTimeStep 32
  contactProperties [
    ContactProperties {
      material1 "caster"
      coulombFriction [
        0
      ]
    }
  ]
}
Viewpoint {
  orientation -0.5773 0.5773 0.5773 2.0944
  position 0 0 5.5
}
TexturedBackground {
}
TexturedBackgroundLight {
}
RectangleArena {
  floorSize 4 3
  floorTileSize 4 3
  floorAppearance PBRAppearance {
    baseColor 1 1 1
    roughness 1
    metalness 0
  }
  wallHeight 0.15
}

# --- LINTASAN GARIS HITAM (1 Lurus Panjang + Tikungan Tajam Kiri & Kanan) ---
